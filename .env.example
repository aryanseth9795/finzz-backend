# ─── Required ────────────────────────────────────────────────────────────────
# The server refuses to start without these. There are deliberately no
# fallbacks: a default secret is worse than a crash.

MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<db>
# Generate with: openssl rand -base64 48   (minimum 32 characters)
JWT_SECRET=
# Minimum 24 characters. The single credential guarding every admin action.
ADMIN_SECRET_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Token lifetimes (any value `jsonwebtoken` accepts)
ACCESS_TOKEN_EXPIRES_IN=2d
REFRESH_TOKEN_EXPIRES_IN=30d
ADMIN_TOKEN_EXPIRES_IN=12h

# Comma-separated origins allowed to send credentialed requests.
CLIENT_ORIGINS=https://finzzadmin.netlify.app,http://localhost:5173

# Public URL of this service. Enables the keep-alive self-ping when set;
# the ping is skipped entirely when it is absent.
API_URL=

# Rate limiting (global tier; auth/OTP tiers are fixed in code)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Email delivery for OTPs
# Email delivery. Set MAIL_TRANSPORT=console for local dev to log OTPs
# instead of sending mail (refused in production).
MAIL_TRANSPORT=resend
RESEND_API=

# Cloudinary (avatar and pool image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=finzz

MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp
